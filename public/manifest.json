{
    "manifest_version": 3,
    "name": "Wise squirrel - bookmark manager",
    "version": "1.0",
    "description": "Wise Squirrel is a bookmark manager that organizes your saved content, allowing you to access all your bookmarks from any device.",
    "action": {
      "default_icon": {
        "16": "icons/logo16.png",
        "48": "icons/logo48.png",
        "128": "icons/logo128.png"
      }
    },
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
    {
      "matches": ["https://*/*"], 
      "js": ["content.js"],
      "css":["content.css"]
    }
  ],
  "side_panel": {
      "default_path": "sidePanel.html",
      "default_icon": {
        "16": "icons/logo16.png",
        "48": "icons/logo48.png",
        "128": "icons/logo128.png"
      }
    },
    "permissions": [
      "storage",
      "sidePanel"
    ]
  }
